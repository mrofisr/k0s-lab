# Cloudflare proxied DNS -> Caddy (Origin CA) -> Istio
#
# Requires a Cloudflare Origin CA certificate for *.cluster.jawara.cloud and
# cluster.jawara.cloud, installed at:
#   /etc/caddy/certs/cluster-origin.pem
#   /etc/caddy/certs/cluster-origin.key
#
# Cloudflare SSL/TLS mode must be Full (strict). Only Cloudflare edge IPs are
# allowed to use this site; direct requests to the origin get 403.
#
# Install as /etc/caddy/sites/cluster-wildcard.caddy, then:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

https://*.cluster.jawara.cloud {
	tls /etc/caddy/certs/cluster-origin.pem /etc/caddy/certs/cluster-origin.key

	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

	handle @cloudflare {
		reverse_proxy 10.0.0.81:30080 {
			header_up Host {host}
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto https
		}
		header -Server
	}

	respond "Forbidden" 403
}
